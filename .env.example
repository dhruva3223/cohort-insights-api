# MongoDB connection string
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DB=cohort_insights

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Max documents per user in queued|processing|enriching
MAX_ACTIVE_PER_USER=3

# Safety TTL (seconds) on active_jobs:{user_id}; must exceed longest pipeline run
RATE_LIMIT_KEY_TTL_S=3600

# Content-cache TTL (seconds) for cache:content:{hash}
CACHE_TTL_S=86400

# Stage 1 (processing) simulated delay range in seconds
PROCESSING_MIN_S=10
PROCESSING_MAX_S=20

# Stage 2 (enriching) simulated delay range in seconds
ENRICHING_MIN_S=5
ENRICHING_MAX_S=15

# Independent random failure probability per stage (0.0–1.0)
PROCESSING_FAILURE_RATE=0.1
ENRICHING_FAILURE_RATE=0.1

# Root log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
